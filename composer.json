{
	"name": "contentreactor/core",
	"description": "ContentReactor Template plugin for site.",
	"type": "library",
	"license": "MIT",
	"version": "3.0.0",
	"keywords": [
		"craft",
		"cms",
		"craftcms",
		"craft-plugin",
		"contentreactor"
	],
	"authors": [
		{
			"name": "ContentReactor",
			"homepage": "https://www.contentreactor.com/"
		},
		{
			"name": "ContentReactor Support",
			"email": "support@contentreactor.com"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.2",
		"craftcms/cms": "^5.8"
	},
	"require-dev": {
		"developion/coding-standards": "^1.1",
		"fakerphp/faker": "^1.23",
		"friendsofphp/php-cs-fixer": "^3.54",
		"marcusgaius/phpstan": "^1.0",
		"markhuot/craft-pest": "^2.0",
		"nystudio107/craft-autocomplete": "^1.12",
		"markhuot/craft-pest-core": "^2.0",
		"pestphp/pest": "^3.8"
	},
	"autoload": {
		"psr-4": {
			"ContentReactor\\Core\\": "src/",
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"phpstan": "phpstan --memory-limit=2G",
		"check-cs": "php-cs-fixer check --diff --ansi --using-cache=no",
		"fix-cs": "php-cs-fixer fix --diff --ansi --using-cache=no",
		"pest": "pest"
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"yiisoft/yii2-composer": true,
			"pestphp/pest-plugin": true
		}
	}
}
